<RCC>
    <qresource prefix="/">
        <file alias="qml/main.qml">src/qml/main.qml</file>
        <file alias="qml/GameBoard.qml">src/qml/GameBoard.qml</file>
        <file alias="qml/PlayingPanel.qml">src/qml/PlayingPanel.qml</file>
        <file alias="qml/PortraitPanel.qml">src/qml/PortraitPanel.qml</file>
        <file alias="qml/FunctionButton.qml">src/qml/FunctionButton.qml</file>
        <file alias="qml/SelectColorDialog.qml">src/qml/SelectColorDialog.qml</file>
        <file alias="qml/ResultDialog.qml">src/qml/ResultDialog.qml</file>
        <file alias="qml/ExitDialog.qml">src/qml/ExitDialog.qml</file>
        <file alias="qml/Metrics.js">src/qml/Metrics.js</file>
        <!-- 字体与音效直接复用原仓库 gomoku/assets/resources 下的文件，避免重复 -->
        <file alias="resources/font/ResourceHanRoundedCN-Bold.ttf">../gomoku/assets/resources/font/ResourceHanRoundedCN-Bold.ttf</file>
        <file alias="resources/music/chessone.wav">../gomoku/assets/resources/music/chessone.wav</file>
        <file alias="resources/music/win.wav">../gomoku/assets/resources/music/win.wav</file>
        <file alias="resources/music/fail.wav">../gomoku/assets/resources/music/fail.wav</file>
    </qresource>
</RCC>
